{
  "name": "recent-movers-manufacturing-alert",
  "version": "1.0.0",
  "description": "Web app for daily alerts about UK companies that have recently moved into manufacturing premises",
  "main": "server/index.js",
  "scripts": {
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "server": "nodemon server/index.js",
    "client": "cd client && npm start",
    "build": "cd client && npm run build",
    "start": "node server/index.js",
    "install-all": "npm install && cd client && npm install",
    "test": "jest"
  },
  "dependencies": {
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "axios": "^1.6.0",
    "node-cron": "^3.0.3",
    "@sendgrid/mail": "^8.1.0",
    "csv-writer": "^1.6.0",
    "moment-timezone": "^0.5.43",
    "joi": "^17.11.0"
  },
  "devDependencies": {
    "nodemon": "^3.0.1",
    "concurrently": "^8.2.2",
    "jest": "^29.7.0",
    "supertest": "^6.3.3"
  },
  "keywords": ["manufacturing", "alerts", "movers", "b2b", "emailmovers"],
  "author": "",
  "license": "MIT"
}