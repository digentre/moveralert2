# Emailmovers API Configuration
EMAILMOVERS_API_KEY=your_emailmovers_api_key_here
EMAILMOVERS_BASE_URL=https://api.emailmovers.com/v1

# Email Provider Configuration (SendGrid)
SENDGRID_API_KEY=your_sendgrid_api_key_here
FROM_EMAIL=alerts@yourdomain.com

# Application Configuration
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:3000

# CRON Schedule (08:00 UK time daily)
CRON_SCHEDULE=0 8 * * *

# Security
JWT_SECRET=your_jwt_secret_here

# Database (if needed for future)
# DATABASE_URL=postgresql://username:password@localhost:5432/moveralert